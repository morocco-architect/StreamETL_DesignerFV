# Copy to .env and adjust as needed. backend/config.py reads these with
# sensible defaults matching deploy/docker-compose.yml, so this file is
# only required when you deviate from the default setup.

# Host-side Kafka bootstrap (used by the FastAPI backend running on your machine)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Docker-internal Kafka bootstrap (used inside the generated PySpark job,
# which runs inside the spark-master container)
KAFKA_INTERNAL_BOOTSTRAP_SERVERS=kafka:29092

# Must match the `container_name` of the spark-master service in
# deploy/docker-compose.yml
SPARK_MASTER_CONTAINER=streametl-spark-master
SPARK_MASTER_URL=spark://streametl-spark-master:7077
SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.1

# PostgreSQL (pipeline persistence)
DATABASE_URL=postgresql://admin:admin@localhost:5433/streametl

# Comma-separated list of origins allowed to call the API (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Optional Pipeline Intelligence provider
# Core /analyze, /repair and rule-first /diagnose work with AI disabled.
# Only /api/intelligence/generate requires an enabled provider.
# ---------------------------------------------------------------------------
STREAMETL_AI_PROVIDER=disabled
STREAMETL_AI_MODEL=gpt-5.6-luna
STREAMETL_AI_TIMEOUT_SECONDS=60

# OpenAI provider (when STREAMETL_AI_PROVIDER=openai)
OPENAI_API_KEY=

# Ollama provider (when STREAMETL_AI_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
