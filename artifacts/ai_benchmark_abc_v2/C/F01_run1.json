{
  "nodes": [
    {
      "id": "node1",
      "type": "kafkaTopic",
      "data": {
        "label": "raw_orders",
        "params": {
          "bootstrap.servers": "localhost:9092",
          "topic": "raw_orders",
          "readMode": "stream",
          "startingOffset": "latest"
        }
      },
      "position": {
        "x": 80.0,
        "y": 80.0
      }
    },
    {
      "id": "node2",
      "type": "sparkTransform",
      "data": {
        "transformType": "ParseJSON",
        "params": {
          "schema": "order_id STRING, user_id INT, amount DOUBLE, status STRING, event_time TIMESTAMP"
        }
      },
      "position": {
        "x": 340.0,
        "y": 80.0
      }
    },
    {
      "id": "node3",
      "type": "sparkTransform",
      "data": {
        "transformType": "Filter",
        "params": {
          "condition": "status = 'COMPLETED' AND amount > 100"
        }
      },
      "position": {
        "x": 600.0,
        "y": 80.0
      }
    },
    {
      "id": "node4",
      "type": "kafkaTopic",
      "data": {
        "label": "filtered_orders",
        "params": {
          "bootstrap.servers": "localhost:9092",
          "topic": "filtered_orders",
          "readMode": "stream",
          "startingOffset": "latest"
        }
      },
      "position": {
        "x": 860.0,
        "y": 80.0
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "node1",
      "target": "node2"
    },
    {
      "id": "e2",
      "source": "node2",
      "target": "node3"
    },
    {
      "id": "e3",
      "source": "node3",
      "target": "node4"
    }
  ],
  "explanation": "Streaming Kafka-to-Kafka DAG with JSON parsing, filtering, and Kafka output"
}