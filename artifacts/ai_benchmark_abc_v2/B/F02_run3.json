{
  "nodes": [
    {
      "id": "node_1",
      "type": "kafkaTopic",
      "data": {
        "label": "raw_orders",
        "params": {
          "readMode": "stream",
          "startingOffset": "earliest"
        }
      },
      "position": {
        "x": 80.0,
        "y": 80.0
      }
    },
    {
      "id": "node_2",
      "type": "sparkTransform",
      "data": {
        "transformType": "ParseJSON",
        "params": {
          "schema": "order_id STRING, user_id INT, amount DOUBLE, status STRING, event_time TIMESTAMP"
        }
      },
      "position": {
        "x": 340.0,
        "y": 80.0
      }
    },
    {
      "id": "node_3",
      "type": "sparkTransform",
      "data": {
        "transformType": "Filter",
        "params": {
          "condition": "status = 'COMPLETED' AND amount > 200"
        }
      },
      "position": {
        "x": 600.0,
        "y": 80.0
      }
    },
    {
      "id": "node_4",
      "type": "kafkaTopic",
      "data": {
        "label": "filtered_orders",
        "params": {
          "readMode": "stream",
          "startingOffset": "earliest"
        }
      },
      "position": {
        "x": 860.0,
        "y": 80.0
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "node_1",
      "target": "node_2"
    },
    {
      "id": "e2",
      "source": "node_2",
      "target": "node_3"
    },
    {
      "id": "e3",
      "source": "node_3",
      "target": "node_4"
    }
  ],
  "explanation": "Streaming order filter pipeline: input Kafka raw_orders, parse JSON, filter status and amount, output Kafka filtered_orders"
}