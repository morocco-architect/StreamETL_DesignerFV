  {
    "id": "W01",
    "prompt": "Design a streaming pipeline reading raw_orders, parsing \"order_id STRING, user_id INT, amount DOUBLE, status STRING, event_time TIMESTAMP\", GroupBy user_id with a 10 minute event-time window, 5 minute slide, 10 minute watermark on event_time, then Aggregate sum(amount) alias total_amount. Write append-finalized results to Parquet /tmp/parquet_windowed_sales.",
    "reference": {
      "nodes": [
        {
          "id": "orders-source",
          "type": "kafkaTopic",
          "data": {
            "label": "raw_orders",
            "params": {
              "readMode": "stream",
              "startingOffset": "earliest",
              "consumerGroupId": "streametl-window-example"
            }
          }
        },
        {
          "id": "parse-orders",
          "type": "sparkTransform",
          "data": {
            "transformType": "ParseJSON",
            "params": {
              "schema": "order_id STRING, user_id INT, amount DOUBLE, status STRING, event_time TIMESTAMP"
            }
          }
        },
        {
          "id": "group-window",
          "type": "sparkTransform",
          "data": {
            "transformType": "GroupBy",
            "params": {
              "columns": "user_id",
              "windowEnabled": true,
              "windowDuration": "10 minutes",
              "windowSlide": "5 minutes",
              "timestampCol": "event_time",
              "watermarkDelay": "10 minutes"
            }
          }
        },
        {
          "id": "sum-amount",
          "type": "sparkTransform",
          "data": {
            "transformType": "Aggregate",
            "params": {
              "aggregations": [
                {
                  "func": "sum",
                  "col": "amount",
                  "alias": "total_amount"
                }
              ]
            }
          }
        },
        {
          "id": "parquet-sink",
          "type": "parquetSink",
          "data": {
            "path": "/tmp/parquet_windowed_sales",
            "params": {}
          }
        }
      ],
      "edges": [
        {
          "source": "orders-source",
          "target": "parse-orders"
        },
        {
          "source": "parse-orders",
          "target": "group-window"
        },
        {
          "source": "group-window",
          "target": "sum-amount"
        },
        {
          "source": "sum-amount",
          "target": "parquet-sink"
        }
      ]
    },
    "original": "windowed_sales_to_parquet.json"
  },
